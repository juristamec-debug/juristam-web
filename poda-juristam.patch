-.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
-header{background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100;height:90px;}
-.header-inner{max-width:780px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:100%;}
-.brand-logo{height:80px;width:auto;}.btn-back{background:var(--primary-light);color:var(--primary-dark);padding:.5rem 1rem;border-radius:8px;font-size:.85rem;font-weight:600;}
-.btn-back:hover{background:var(--primary);color:var(--white);}
-.container{max-width:780px;margin:0 auto;padding:0 1.5rem;}
-.breadcrumb{font-size:.82rem;color:var(--text-secondary);padding:1.2rem 0 .5rem;}
-.breadcrumb a{color:var(--primary-dark);}.breadcrumb a:hover{text-decoration:underline;}.breadcrumb span{margin:0 .4rem;}
-.meta-wrap{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin:.8rem 0 1.2rem;font-size:.82rem;}
-.tag{background:var(--primary-light);color:var(--primary-dark);padding:.22rem .7rem;border-radius:20px;font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;}
-.meta-date{color:var(--text-secondary);}
-h1{font-family:'Lora',serif;font-size:clamp(1.9rem,4.5vw,2.5rem);line-height:1.2;color:var(--text);margin-bottom:1rem;font-weight:700;}
-.catline{font-size:.88rem;color:var(--text-secondary);margin-bottom:1rem;}.catline a{color:var(--primary-dark);font-weight:600;}
-article h2{font-family:'Lora',serif;font-size:1.45rem;color:var(--text);margin:2.5rem 0 1rem;line-height:1.3;font-weight:700;}
-article h3{font-size:1.05rem;color:var(--primary-dark);margin:1.8rem 0 .7rem;font-weight:700;}
-article p{margin-bottom:1.2rem;font-size:.97rem;color:var(--text);}
-article ul,article ol{margin:.5rem 0 1.2rem 1.4rem;}
-article ul li,article ol li{margin-bottom:.6rem;font-size:.95rem;color:var(--text-secondary);line-height:1.7;}
-article ul li strong,article ol li strong{color:var(--text);}
-.autor-block{display:flex;align-items:center;gap:.9rem;padding:1rem 1.2rem;background:var(--gray-light);border:1px solid var(--border);border-radius:10px;margin:1rem 0 1.8rem;}
-.autor-block img{border-radius:8px;background:var(--primary-light);padding:4px;flex-shrink:0;}
-.autor-nombre{font-size:.82rem;font-weight:700;color:var(--text);margin-bottom:.15rem;}
-.autor-cargo{font-size:.76rem;color:var(--text-secondary);line-height:1.5;margin-bottom:.2rem;}
-.autor-fecha{font-size:.73rem;color:var(--primary-dark);}
-.cta-urgente{background:var(--danger-light);border:1.5px solid var(--danger);border-radius:12px;padding:1.1rem 1.5rem;margin:1.5rem 0;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
-.cta-urgente p{margin:0;font-size:.93rem;font-weight:600;color:var(--danger);flex:1;}
-.cta-urgente p span{display:block;font-weight:400;color:var(--text-secondary);font-size:.86rem;margin-top:.2rem;}
-.btn-wa{background:#25d366;color:#fff;padding:.65rem 1.3rem;border-radius:8px;font-size:.88rem;font-weight:700;white-space:nowrap;display:inline-block;}
-.btn-wa:hover{background:#1da851;}
-.tldr{background:var(--primary-light);border-left:4px solid var(--primary);padding:1.2rem 1.5rem;border-radius:0 10px 10px 0;margin:1.5rem 0 2rem;font-size:.96rem;line-height:1.78;}
-.tldr strong{color:var(--primary-dark);}
-.callout{background:var(--primary-light);border-radius:10px;padding:1.2rem 1.5rem;margin:1.8rem 0;font-size:.94rem;}
-.callout strong{color:var(--primary-dark);display:block;margin-bottom:.4rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;}
-.callout-danger{background:var(--danger-light);border-left:4px solid var(--danger);border-radius:0 10px 10px 0;padding:1.2rem 1.5rem;margin:1.8rem 0;font-size:.94rem;}
-.callout-danger strong{color:var(--danger);display:block;margin-bottom:.4rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;}
-.callout-warning{background:var(--warning-light);border-left:4px solid var(--warning);border-radius:0 10px 10px 0;padding:1.2rem 1.5rem;margin:1.8rem 0;font-size:.94rem;}
-.callout-warning strong{color:var(--warning);display:block;margin-bottom:.4rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;}
-.callout-success{background:var(--success-light);border-left:4px solid var(--success);border-radius:0 10px 10px 0;padding:1.2rem 1.5rem;margin:1.8rem 0;font-size:.94rem;}
-.callout-success strong{color:var(--success);display:block;margin-bottom:.4rem;font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;}
-.tabla-wrap{overflow-x:auto;margin:1.5rem 0 2rem;border-radius:10px;border:1px solid var(--border);}
-.tabla{width:100%;border-collapse:collapse;font-size:.88rem;min-width:460px;}
-.tabla th{background:var(--primary-dark);color:#fff;padding:.8rem 1rem;text-align:left;font-weight:600;}
-.tabla td{padding:.8rem 1rem;border-bottom:1px solid var(--border);vertical-align:top;color:var(--text-secondary);}
-.tabla tr:last-child td{border-bottom:none;}.tabla tr:nth-child(even) td{background:var(--gray-light);}
-.tabla td strong{color:var(--text);}
-.pasos{list-style:none;padding:0;margin:1.5rem 0 2rem;display:flex;flex-direction:column;gap:1rem;}
-.paso{display:grid;grid-template-columns:44px 1fr;gap:1rem;align-items:start;padding:1rem 1.2rem;background:var(--gray-light);border-radius:10px;border:1px solid var(--border);}
-.paso-num{width:44px;height:44px;background:var(--primary-dark);color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;flex-shrink:0;}
-.paso-titulo{font-weight:700;font-size:.93rem;color:var(--text);margin-bottom:.3rem;}
-.paso-desc{font-size:.87rem;color:var(--text-secondary);line-height:1.65;margin:0;}
-.cta-block{background:var(--primary-dark);color:#fff;border-radius:14px;padding:2rem 1.8rem;text-align:center;margin:2.5rem 0;}
-.cta-block h3{font-family:'Lora',serif;font-size:1.4rem;margin-bottom:.8rem;}
-.cta-block p{color:#e2d9ff;margin-bottom:1.4rem;font-size:.92rem;}
-.btn-solid{background:#fff;color:var(--primary-dark);padding:.85rem 2rem;border-radius:10px;font-size:.95rem;font-weight:700;display:inline-block;box-shadow:0 4px 14px rgba(0,0,0,.2);}
-.btn-solid:hover{background:var(--primary-light);}
-.price-banner{background:linear-gradient(135deg,#1e0a4e,#2d1060);border-radius:14px;padding:1.6rem 1.8rem;margin:2.5rem 0;color:#fff;text-align:center;}
-.price-banner h3{font-family:'Lora',serif;font-size:1.1rem;margin-bottom:.5rem;color:#fff;}
-.price-banner>p{font-size:.85rem;color:#c4b5fd;margin-bottom:1.2rem;}
-.pbc-grid{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-bottom:1rem;}
-.pbc{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:1rem 1.4rem;min-width:130px;text-align:center;}
-.pbc.featured{background:rgba(154,106,255,.25);border-color:rgba(154,106,255,.5);}
-.pbc-label{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#c4b5fd;margin-bottom:.3rem;}
-.pbc-price{font-size:2rem;font-weight:800;color:#fff;line-height:1;}
-.pbc-note{font-size:.65rem;color:rgba(255,255,255,.6);margin-top:.3rem;line-height:1.3;}
-.price-banner .nota{font-size:.78rem;color:#e2d9ff;margin-bottom:1.2rem;background:rgba(255,255,255,.06);border-radius:8px;padding:.7rem 1rem;}
-.btn-price-wa{display:inline-flex;align-items:center;gap:.5rem;background:#25d366;color:#fff;padding:.75rem 1.6rem;border-radius:10px;font-weight:700;font-size:.9rem;}
-.btn-price-wa:hover{background:#1da851;}
-.related{background:var(--gray-light);border-radius:12px;padding:1.5rem;margin:2.5rem 0;}
-.related h3{font-size:.95rem;font-weight:700;color:var(--text);margin-bottom:1rem;}
-.related ul{list-style:none;margin:0;padding:0;}
-.related ul li{margin-bottom:.6rem;padding-bottom:.6rem;border-bottom:1px solid var(--border);}
-.related ul li:last-child{border-bottom:none;margin-bottom:0;}
-.related ul li a{color:var(--primary-dark);font-size:.9rem;font-weight:500;}
-.related ul li a:hover{text-decoration:underline;}
-.faq-section{margin:2.5rem 0;}.faq-section h2{margin-bottom:1.2rem;}
-details{border-bottom:1px solid var(--border);padding:1rem 0;}
-summary{font-weight:600;cursor:pointer;color:var(--text);font-size:.96rem;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem;}
-summary::-webkit-details-marker{display:none;}
-summary::after{content:"+";color:var(--primary);font-size:1.3rem;font-weight:300;flex-shrink:0;}
-details[open] summary::after{content:"−";}
-.faq-answer{margin-top:.8rem;font-size:.91rem;color:var(--text-secondary);line-height:1.8;}
-.trust-block{border:1px solid var(--border);border-radius:12px;padding:1.3rem 1.5rem;margin:2rem 0;background:var(--gray-light);}
-.trust-label{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--primary-dark);margin-bottom:.8rem;display:block;}
-.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:.9rem;}
-.trust-item{text-align:center;padding:.7rem;background:var(--white);border-radius:8px;border:1px solid var(--border);}
-.trust-num{font-size:1.4rem;font-weight:800;color:var(--text);}
-.trust-desc{font-size:.72rem;color:var(--text-secondary);margin-top:.2rem;}
-.trust-text{font-size:.76rem;color:#6b7280;line-height:1.65;}
-.satelite-link{background:#e0f2fe;border:1px solid #7dd3fc;border-left:4px solid #0284c7;border-radius:0 10px 10px 0;padding:1rem 1.4rem;margin:1.5rem 0;font-size:.88rem;line-height:1.7;color:#0c4a6e;}
-.satelite-link a,.satelite-link a:link,.satelite-link a:visited{color:#0369a1 !important;font-weight:700 !important;text-decoration:underline !important;text-underline-offset:3px !important;}
-.satelite-link a:hover{color:#0284c7 !important;}
-.satelite-link strong{color:#0c4a6e;font-weight:700;}
-.pilar-link{background:linear-gradient(135deg,#1e0a4e,#2d1060);border-radius:12px;padding:1.2rem 1.5rem;margin:2rem 0;color:#fff;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
-.pilar-link p{margin:0;font-size:.87rem;color:#e2d9ff;flex:1;}
-.pilar-link a{display:inline-block;background:#9a6aff;color:#fff;padding:.55rem 1.2rem;border-radius:8px;font-weight:700;font-size:.84rem;white-space:nowrap;}
-.pilar-link a:hover{background:#7c3aed;}
-.wa-modal-overlay{position:fixed;inset:0;z-index:2000;background:rgba(10,10,15,.45);backdrop-filter:blur(6px);display:flex;align-items:flex-end;justify-content:center;padding:0 0 80px;opacity:0;pointer-events:none;transition:opacity .22s ease;}
-.wa-modal-overlay.active{opacity:1;pointer-events:all;}
-.wa-modal{background:#fff;border-radius:20px;padding:28px 22px 22px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,.18);transform:translateY(18px);transition:transform .25s cubic-bezier(.34,1.3,.64,1);position:relative;box-sizing:border-box;}
-.wa-modal-overlay.active .wa-modal{transform:translateY(0);}
-.wa-modal-close{position:absolute;top:14px;right:14px;background:#f3f4f6;border:none;border-radius:999px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280;font-size:.8rem;}
-.wa-modal-close:hover{background:#e5e7eb;}
-.wa-modal-icon{width:40px;height:40px;background:#25d366;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
-.wa-modal-title{font-weight:700;font-size:1.1rem;color:var(--text);margin-bottom:6px;}
-.wa-modal-subtitle{font-size:.82rem;color:var(--text-secondary);line-height:1.65;margin-bottom:16px;}
-.wa-modal-prices{display:flex;gap:10px;margin-bottom:16px;}
-.wa-price-box{flex:1;border-radius:12px;padding:12px 10px;text-align:center;border:1px solid var(--border);background:var(--gray-light);}
-.wa-price-box.featured{border-color:rgba(154,106,255,.3);background:var(--primary-light);}
-.wa-price-label{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--primary-dark);margin-bottom:4px;}
-.wa-price-amount{font-weight:800;font-size:1.6rem;color:var(--text);line-height:1;}
-.wa-price-note{font-size:.64rem;color:#6b7280;margin-top:4px;line-height:1.3;}
-.wa-modal-note{font-size:.76rem;color:var(--text-secondary);background:var(--gray-light);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:16px;line-height:1.6;}
-.wa-modal-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:11px 16px;border-radius:10px;background:#25d366;color:#fff;font-weight:600;font-size:.86rem;text-decoration:none;}
-.wa-modal-btn:hover{background:#1da851;}
-footer{background:var(--text);color:#ccc;padding:2rem 0;text-align:center;font-size:.84rem;margin-top:3rem;}
-footer a{color:var(--primary);}footer strong{color:#fff;}
-@media(max-width:600px){h1{font-size:1.7rem;}.cta-urgente{flex-direction:column;align-items:flex-start;}.cta-block{padding:1.5rem 1rem;}.trust-grid{grid-template-columns:repeat(2,1fr);}}
-@media(min-width:640px){.wa-modal-overlay{align-items:center;padding:0;}.wa-modal{max-width:400px;}}
