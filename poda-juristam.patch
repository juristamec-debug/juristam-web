-          <tr><td>Persona natural (caso especial)</td><td>Hasta 2</td><td>Hasta 2</td><td>Con justificación previa, Art. 77</td></tr>
-          <tr><td>Coleccionista</td><td>Sin límite fijo</td><td>—</td><td>Solo exhibición, Art. 20 y 13 g)</td></tr>
-          <tr><td>Empresa/negocio propio</td><td>Hasta 5</td><td>—</td><td>Art. 95 Reglamento</td></tr>
